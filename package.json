{
  "name": "treasure-mountain",
  "version": "1.0.0",
  "private": true,
  "description": "A from-scratch remake of the 1990 educational game Treasure Mountain! for the browser, home screens and Android.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/playtest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
